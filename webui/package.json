{
  "name": "noahai-web-ui",
  "private": true,
  "version": "3.9.207",
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "node electron/run-electron.cjs",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lightweight-charts": "^5.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "43.7.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "ai.noah.client",
    "productName": "NoahAI",
    "buildVersion": "3.9.2.7",
    "asar": true,
    "beforePack": "electron/branding-preflight.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../deploy/web-engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NoahAI-3.9.2.7-Setup.${ext}",
      "executableName": "NoahAI",
      "icon": "../icon.ico"
    },
    "mac": {
      "icon": "../icon.png",
      "category": "public.app-category.finance"
    },
    "nsis": {
      "installerIcon": "../icon.ico",
      "uninstallerIcon": "../icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nwsoft",
        "repo": "ai-trading-client"
      }
    ]
  }
}
