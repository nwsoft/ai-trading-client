    def update_today_report(self, report):
        """오늘 리포트 업데이트"""
        try:
            self.today_summary_labels['total_trades'].configure(text=str(report['total_trades']))
            self.today_summary_labels['win_rate'].configure(text=f"{report['win_rate']}%")
            self.today_summary_labels['profit_rate'].configure(text=f"{report['profit_rate']}%")
            self.today_summary_labels['max_loss'].configure(text=f"{report['max_loss']}%")
            self.today_summary_labels['sharpe_ratio'].configure(text=str(report['sharpe_ratio']))
            self.today_summary_labels['volume'].configure(text=f"{report['volume']:,} USDT")
            
            self.today_detail_text.delete("1.0", "end")
            self.today_detail_text.insert("1.0", report['detail'])
            
        except Exception as e:
            print(f"오늘 리포트 업데이트 오류: {e}")
    
    def update_weekly_report(self, report):
        """주간 리포트 업데이트"""
        try:
            self.weekly_summary_labels['total_trades'].configure(text=str(report['total_trades']))
            self.weekly_summary_labels['avg_win_rate'].configure(text=f"{report['avg_win_rate']}%")
            self.weekly_summary_labels['cumulative_profit'].configure(text=f"{report['cumulative_profit']}%")
            self.weekly_summary_labels['best_day'].configure(text=report['best_day'])
            self.weekly_summary_labels['worst_day'].configure(text=report['worst_day'])
            self.weekly_summary_labels['volatility'].configure(text=f"{report['volatility']}%")
            
            self.weekly_detail_text.delete("1.0", "end")
            self.weekly_detail_text.insert("1.0", report['detail'])
            
        except Exception as e:
            print(f"주간 리포트 업데이트 오류: {e}")
    
    def update_monthly_report(self, report):
        """월간 리포트 업데이트"""
        try:
            self.monthly_summary_labels['total_trades'].configure(text=str(report['total_trades']))
            self.monthly_summary_labels['monthly_profit'].configure(text=f"{report['monthly_profit']}%")
            self.monthly_summary_labels['monthly_win_rate'].configure(text=f"{report['monthly_win_rate']}%")
            self.monthly_summary_labels['best_week'].configure(text=report['best_week'])
            self.monthly_summary_labels['worst_week'].configure(text=report['worst_week'])
            self.monthly_summary_labels['sharpe_ratio'].configure(text=str(report['sharpe_ratio']))
            
            self.monthly_detail_text.delete("1.0", "end")
            self.monthly_detail_text.insert("1.0", report['detail'])
            
        except Exception as e:
            print(f"월간 리포트 업데이트 오류: {e}")
